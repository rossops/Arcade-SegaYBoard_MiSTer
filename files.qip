# Sega Y Board — project file list. Add files here, never in the Quartus IDE.
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SDC_FILE Arcade-SegaYBoard.sdc

set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SegaYBoard.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yb_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/yb_core.sv
set_global_assignment -name MIF_FILE       rtl/video/yb_shifter.hex
set_global_assignment -name SEARCH_PATH    rtl/video

set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/yb_video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/yb_fb_if.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/yb_palette_5242.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/yb_ysprite_5305.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/yb_rotate_5306.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/yb_bsprite_5196.sv
# Y Board video still to write: 315-5305 sprite generator + 315-5306 rotation, the
# 16B sprite layer, the mixer. There is no tilemap and no road on this board.

set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/yb_m68k_bus.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/yb_rom_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/yb_math_5248.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/yb_math_5249.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/yb_ana_shape.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/yb_315_5296.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/yb_msm6253.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/yb_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/yb_dpram.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/yb_segapcm_5218.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/yb_soundsys.sv

set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name QIP_FILE rtl/cpu/fx68k/fx68k.qip
set_global_assignment -name QIP_FILE rtl/audio/jt51/jt51.qip
set_global_assignment -name QIP_FILE rtl/audio/T80/T80.qip
